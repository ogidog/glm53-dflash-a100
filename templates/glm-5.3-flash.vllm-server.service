# systemd unit template — GLM-5.3-Flash TP4+EP4 + DFlash2 (port 8382)
# Replace <USER> with the service user and fix the paths to your venv/models.
# Restart=no on purpose: a crashed server must not flap on a box also used
# for other GPU work.

[Unit]
Description=vLLM GLM-5.3-Flash Service (TP4+EP4, DFlash2 drafter, port 8382)
After=network.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=simple
User=<USER>
Group=<USER>
WorkingDirectory=/home/<USER>

Environment="PYTHONPATH=/home/<USER>/vllm-dflash"   # drop if you patched the tree
Environment="CUDA_VISIBLE_DEVICES=0,1,2,3"
Environment="NCCL_ALGO=Ring"
Environment="NCCL_PROTO=Simple"
Environment="HF_HUB_OFFLINE=1"
Environment="PATH=/home/<USER>/vllm-backport/venv/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/home/<USER>/vllm-backport/venv/bin/vllm serve \
  /home/<USER>/models/GLM-5.3-Flash-AWQ-W4A16 \
  --served-model-name GLM-5.3-Flash \
  --port 8382 \
  --tensor-parallel-size 4 --enable-expert-parallel \
  --max-model-len 262144 --gpu-memory-utilization 0.94 \
  --max-num-seqs 2 --max-num-batched-tokens 8192 \
  --enable-prefix-caching --prefix-match-unit 16 --prefix-cache-retention-interval 1280 --enable-prompt-tokens-details --disable-custom-all-reduce \
  --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[1,2,4,8,9,16,18],"max_cudagraph_capture_size":18}' \
  --speculative-config '{"model":"/home/<USER>/drafters/GLM-5.3-Flash-DFlash2","num_speculative_tokens":8}' \
  --enable-auto-tool-choice --tool-call-parser glm47 --reasoning-parser glm45 \
  --host 0.0.0.0

Restart=no
RestartSec=15
LimitNOFILE=1048576
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
